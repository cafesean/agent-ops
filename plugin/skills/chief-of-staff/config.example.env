# agent-ops config. /agent-ops:init writes it to ~/.claude/agent-ops/config.env (override: $AGENT_OPS_CONFIG).
# That file is NOT in git and stays PER MACHINE. Every script loads it via scripts/cos-env.sh. Placeholders only.
# Several machines: they share ONE state dir (put COS_DIR in a folder they all sync); each keeps its own config.env
# with its own COS_MACHINE_PREFIX, runs its own chief + queue-run.sh, and spawns only tasks addressed `to: <its prefix>`.
# Workers always run on the machine that spawns them; there is no ssh/remote launch.

# ============================== Core ==============================
# State dir: tasks/, briefs/, GOALS.md, STATE.md, Outstanding.md live here (default $HOME/agent-ops/state).
COS_DIR="$HOME/agent-ops/state"
# COS_OUTSTANDING="$COS_DIR/Outstanding.md"      # the ONE list the owner reads (default shown)
# COS_GOALS="$COS_DIR/GOALS.md"                  # goal headings `### <ID> · <outcome>` (default shown)
# COS_MONOREPO="<repo-root>"                     # optional: dir holding your repos / STATE.md
# COS_INVENTORY="<path>.yaml"                    # optional: your hosts inventory file (sources-of-truth; key names only)
# User layer: YOUR rules.md, bin/ scripts and README, outside the plugin (plugin updates never touch it).
# COS_USER_DIR="$COS_DIR/user"                   # default shown; /agent-ops:init creates the skeleton

# Session logging — where /agent-ops:session-* write. Per-project .agent-ops.json (sessionsDir, specsDir) wins;
# these apply when a repo has none; unset → ./sessions and ./specs in the repo root (relative = per repo).
# COS_SESSIONS_DIR=./sessions
# COS_SPECS_DIR=./specs
# COS_MEMORY_DIR=<memory-dir>                    # where /agent-ops:recall also searches (unset = none)

# Plugin tooling — canonical plugin SOURCE repos agent-updater may edit (colon-separated; never ~/.claude/plugins/…).
# Unset → the agent asks for the path.
# COS_PLUGIN_REPOS="<plugin-repo>:<other-plugin-repo>"

# Launch dirs — spawn.sh refuses any --dir not exactly one of these (colon-separated)
COS_LAUNCH_DIRS="<repo-root>"

# How workers open: tmux (new window in tmux session `agent-ops`) | print (prints the claude command, you run it)
# | cmux (add-on below). Default: tmux if installed, else print.
COS_LAUNCHER=tmux
# COS_TMUX_SESSION=agent-ops
# COS_TMUX_SOCKET=<name-or-path>              # own tmux server: a name (tmux -L) or a socket path (tmux -S); default server if unset
#                                              (used by the tmux launcher and by COS_CMUX_TMUX=1)
# COS_TMUX_BIN=tmux                           # tmux binary (a path when tmux is not on PATH); default: tmux on PATH

# Session naming — <machine>-<topic>[-<specifier>][-N], e.g. a-auth-fix (spawn.sh enforces it)
COS_MACHINE_PREFIX=a           # this machine's letter
# COS_HOST_PREFIX=a            # the machine that also owns legacy unprefixed task names (default: this machine)

# Capacity (this machine) — load-check.sh gates new local workers
COS_MAX_LOCAL_SESSIONS=6       # live top-level claude sessions before new work is refused/queued
COS_MIN_FREE_MEM_PCT=20        # free memory % floor
COS_MAX_LOAD_PER_CPU=0.85      # 1-min loadavg / ncpu ceiling
# COS_KILL_ORPHANS=1           # auto-kill orphaned (ppid 1) tsc/vitest/next build processes
# COS_LOAD5_ENTER=0.9          # OFFLOAD bit turns ON when 5-min load / ncpu passes this (lib/loadgate.py)
# COS_LOAD5_LEAVE=0.8          # ... and OFF only below this (hysteresis, no flapping)
# COS_MAX_HEAVY_LOCAL=2        # heavy-cap-guard hook: concurrent heavy local commands (suites, builds, big type-checks)
# COS_ALLOW_HEAVY_CAP=0        # 1 = heavy-cap-guard allows everything (or `# heavy-ok: <reason>` in one command)
# COS_MAX_LIVE_SUBAGENTS=8     # agent-budget-guard hook: live subagents per machine
# COS_SUBAGENT_LIVE_WINDOW=900 # seconds a subagent counts as live after its last write
# COS_ALLOW_SUBAGENT=0         # 1 = agent-budget-guard allows every dispatch
# COS_LOAD_STATE_FILE="$COS_DIR/load-offload.state"   # loadgate hysteresis state (shared by load-check and the hook)
# COS_HEAVY_REMOTE_CMDS="<your-remote-run-cmd>"        # heavy-cap-guard lets commands using these names through (they run elsewhere)

# Worker reporting
# COS_REQUIRE_REFS=0           # 1 = stop.sh DONE also needs a `refs:` line (reference docs updated, or "none")
# COS_HEARTBEAT_MIN=60         # minutes of silence before a worker counts as quiet
# COS_PARK_MIN=50              # minutes an ask may wait before next.sh says "park it"
# COS_ASK_GUARD=1              # ask-guard hook: an ask needs `check:` or `evidence:` (0 = off)
# COS_ASK_FRESH_H=4            # asks.py: hours before an ask must be re-checked to show as NEEDS YOU
# COS_BUILDER_DIRS="<repo-root>"  # role pick: launch dirs under these get builder rules (colon-separated; empty = every dir)
# COS_ASK_SWEEP=1              # next.sh runs `asks.py sweep` each run (0 = off)
# COS_USER_QUEUE_MAX=5         # asks.py queue: most asks shown to the user at once (the rest on one "more:" line)
# COS_USER_NAMES="<name>,<nickname>"   # steering-export.py: names that mark a relayed quote of the user ("user"/"owner" always do)
# COS_CHECKIN_SILENT_MIN=20    # checkin.sh pings workers silent longer than this
# COS_CHECKIN_MAX_IDLE_MIN=50  # ... and idle no longer than this (colder ones are continued, not pinged)
# COS_CLAIM_STALE_MIN=15       # queue-run.sh reopens a `claimed` task with no `where:` after this many minutes
# COS_QUEUE=1                  # next.sh runs queue-run.sh first (0 = off)
# Every *_CMD key below is one shell command line: quote a path that has spaces, e.g. COS_NOTIFY_CMD="bash '/path with spaces/notify.sh'".
# COS_NEEDS_CHECK_CMD="$COS_USER_DIR/bin/<needs-check>"   # queue-run: gets a task's `needs:`; non-zero exit = not met, task waits

# Continuity and context (ctx.py, context-handoff-guard, send-cold-guard, cold-cache-warn)
# COS_CONTINUITY_MIN=50        # spawn.sh exit 6: old session live or last turn newer than this → SendMessage/--resume it
# COS_CTX_WINDOW=1000000       # context window ctx.py measures against (tokens)
# COS_CONTEXT_HANDOFF_TOKENS=  # fixed handover point for every session (empty = per-role default, lib/handoff.py)
# COS_SEND_COLD_MIN=50         # send-cold-guard: no SendMessage to a session idle longer than this
# COS_ALLOW_COLD_SEND=0        # 1 = send-cold-guard allows it anyway
# COS_COLD_WARN=1              # cold-cache-warn hook: note when the user types into a cold session (0 = off)
# COS_WG_COLD_MIN=60           # minutes after which a session's prompt cache counts as cold
# COS_CONTEXT_MARK_DIR="$HOME/.claude/agent-ops/.context-handoff"   # context-handoff-guard once-per-session markers
# COS_HANDOFF_LEAD_RE="<regex>"  # handoff.py: extra session-name regex that gets the lead role (besides -lead)

# Auto-close (reap.sh + cos-reap hook)
# COS_REAP=0                   # 1 = stop DONE / parked / dead workers automatically (through stop.sh gates)
# COS_REAP_IDLE_MIN=60         # idle minutes before reaping; also stop.sh exit 8 window after the user typed
# COS_REAP_DELAY_S=240         # cos-reap hook waits this long after a session ends before reaping
# COS_WORKTREE_OWNER=1         # worktree-owner hook stamps each worker's worktrees for stop.sh exit 9 (0 = off)
# COS_WORKTREE_ROOTS="<repo-root>"   # stop.sh also scans <root>/.git/worktrees and <root>/*/.git/worktrees (colon list)

# Alerts and dead-man (next.sh --alert, run by an external scheduler: cron, launchd, a scheduler agent)
# COS_NOTIFY_CMD="$COS_USER_DIR/bin/<notify>"   # gets each new alert text on stdin (push to phone/chat); unset = print only
# COS_NEXT_HOOK_CMD="bash $COS_USER_DIR/bin/<next-hook>.sh"   # extra per-run sweep from the user layer (gets --alert); unset = none
# COS_DEADMAN_PREFIXES="a b"   # machine prefixes whose $COS_DIR/_heartbeat.<prefix> the host checks (empty = off)
# COS_DEADMAN_MIN=40           # a stamp older than this = that machine's chief is down
# COS_DEADMAN_HOURS=8-22       # local hours the dead-man alerts in

# Worker launch flags
# COS_CLAUDE_BIN=claude                                   # claude binary
# Extra flags for every worker. Workers run unattended: with no flag they STOP at each permission prompt
# until you answer in their pane (safe default). A skip-permissions flag lets them run every tool without
# asking — opt in only if you accept that risk (init asks; never on by default).
# COS_WORKER_CLAUDE_FLAGS="--permission-mode acceptEdits"
# COS_WORKER_DISALLOWED_TOOLS="<tool-pattern> <tool-pattern>"  # tools denied to workers (comma or space separated)
# Opt-in standing rules added to every worker prompt (time-awareness, no-overdoing, test tiers, subagent
# budgets, needs-you banner): copy the ones you want from references/worker-prompt-examples.md.
# COS_WORKER_PROMPT_EXTRA="TEST TIERS: a quick check is the default; smoke only when calling a deploy done."
# COS_REMOTE_CONTROL=1                                    # start workers with Claude Code's --remote-control (drive them from the Claude app; not a remote machine)
# Per-worker environment: a command run once per spawn; its `KEY=value` output lines are exported into that
# worker's launch script only (e.g. a different config dir or proxy). Never print secrets to the terminal.
# COS_SPAWN_ENV_CMD="<command> <worker-name>"
# COS_LAUNCH_SCRIPT_DIR="$COS_DIR/launch"                 # where spawn.sh writes each worker's launch script
# COS_FROM=chief                                          # `from:` stamped on task files spawn.sh creates
# COS_VAULT_ALIAS="$HOME/.claude/agent-ops/vault"        # symlink workers use to reach a vault state dir

# ============================== Platform ==============================
# OS overrides — normally auto-detected by scripts/lib/cos-os.sh; set only when detection is wrong.
# COS_OS=mac                                     # mac | linux | windows
# COS_WSL=0                                      # 1 = running under WSL2
# COS_PYTHON=python3                             # python 3 interpreter the scripts use (never bare python3 in scripts)

# ============================== Add-ons ==============================
# Each add-on is OFF while its variables are unset; its scripts print `addon <name> not configured, skipping`.

# --- cmux launcher: workers open as panes in the chief's cmux workspace ---
# COS_LAUNCHER=cmux
# COS_CMUX_BIN=cmux
# COS_CMUX_WORKSPACE="workspace:<n>"          # pin; default = the workspace titled $COS_CMUX_WORKSPACE_TITLE
# COS_CMUX_WORKSPACE_TITLE=chief
# COS_LAYOUT=row                              # row | grid
# COS_SPAWN_WORKSPACE="workspace:<n>"        # one-shot target workspace (same as spawn.sh --workspace)
# COS_CMUX_HELPERS="$COS_USER_DIR/bin/cmux-helpers.sh"   # optional: your pane layout / focus / colour helpers (sourced)
# COS_CMUX_TMUX=0                             # 1 = each worker's claude runs in its own tmux session (name = worker,
#                                             # on COS_TMUX_SOCKET / COS_TMUX_BIN) and the pane only attaches, so workers
#                                             # survive quitting cmux; stop.sh kills the session. Re-opening attach panes
#                                             # after a cmux restart is left to a user-layer script.

# --- State folder inside a notes vault (any synced markdown folder; e.g. an Obsidian vault) ---
# COS_VAULT="<vault-root>"
# COS_DIR="<vault-root>/<folder>/state"

# --- Jira (cards waiting on you in Outstanding.md; `jira:` tag required at DONE) ---
# COS_JIRA_BASE="https://<jira-host>"         # token from $JIRA_API_TOKEN (Bearer PAT), never stored here
# COS_JIRA_JQL='<jql selecting cards waiting on you>'

# --- Apple Reminders in Outstanding.md (needs the remindctl CLI) ---
# COS_REMINDERS=1

# --- Outstanding.md ---
# COS_OUTSTANDING_SKIP="<folder>:<folder>"   # extra folders (relative to the Outstanding.md dir) whose open boxes are ignored

# --- Focus-aware mode (references/addons/adhd.md): one-screen answers, ONE Thing first, drift nudges ---
# COS_ADHD_MODE=0
